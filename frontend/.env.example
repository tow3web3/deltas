# Public site URL (OG tags, API links, OAuth redirect URIs, the host named in signed messages).
# Must be the same at build time and at run time.
NEXT_PUBLIC_SITE_URL=https://routepay.dev
# Telegram bot username (without @)
NEXT_PUBLIC_BOT_USERNAME=your_bot_username
# Brand accounts. A link that is left empty is not shown on the site.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_COMMUNITY_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# The project token. Leave the address empty until launch: the lottery, the
# missions and the live link stay off without it.
NEXT_PUBLIC_TOKEN_SYMBOL=ROUTEPAY
NEXT_PUBLIC_TOKEN_CA=
# Optional: a lottery on another token than the project token
LOTTERY_TOKEN_ADDRESS=

# Server-side only
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/routepay?sslmode=require
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Admin key for POST /api/v1/launchpads (register launchpads). Server-side only.
HOOKS_ADMIN_KEY=

# Web dashboard (server-side only)
# SESSION_SECRET also signs the platform sign-in cookies and derives the DNS codes of domains.
SESSION_SECRET=
# Same key as the backend: it encrypts dev wallets and page vaults.
MASTER_ENCRYPTION_KEY=
INTERNAL_API_URL=http://127.0.0.1:5400
INTERNAL_API_KEY=

# Pages: sign in with the platform to claim. A platform is switched on by
# setting both of its values. Register this redirect URI with each one:
#   <NEXT_PUBLIC_SITE_URL>/api/oauth/<name>/callback
# where <name> is github, youtube, x, twitch, facebook, instagram or tiktok.
# Domains need nothing: they are claimed with a DNS TXT record.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Google Cloud OAuth client with the YouTube Data API enabled (scope youtube.readonly)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
OAUTH_TWITCH_CLIENT_ID=
OAUTH_TWITCH_CLIENT_SECRET=
# Meta app with Facebook Login (permission pages_show_list)
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
# Meta app with Instagram Login (permission instagram_business_basic)
OAUTH_INSTAGRAM_CLIENT_ID=
OAUTH_INSTAGRAM_CLIENT_SECRET=
# TikTok Login Kit: the client key goes in CLIENT_ID (scopes user.info.basic, user.info.profile)
OAUTH_TIKTOK_CLIENT_ID=
OAUTH_TIKTOK_CLIENT_SECRET=
