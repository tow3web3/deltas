[Unit]
Description=DELTA Telegram bot + scheduler + API (Robinhood Chain)
After=network.target postgresql.service

[Service]
WorkingDirectory=/root/delta/backend
EnvironmentFile=/root/delta/backend/.env
Environment=NODE_ENV=production
Environment=PORT=5400
ExecStart=/usr/bin/node /root/delta/backend/src/index.js
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
