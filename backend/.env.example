# Node
NODE_ENV=development
PORT=3000

# Database (Neon or any Postgres)
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/routepay?sslmode=require

# Robinhood Chain RPC (public endpoint is rate limited; Alchemy and QuickNode offer dedicated ones)
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Site URL (dashboard, receipt and page links in Telegram and webhooks)
FRONTEND_URL=http://localhost:3001
# Brand accounts. One that is left empty is left out of the bot's messages.
X_HANDLE=
COMMUNITY_URL=

# The project token. Leave the address empty until launch: the holders-only
# gate, the default of /burns and the lottery stay off without it.
PROJECT_TOKEN_ADDRESS=
PROJECT_TOKEN_SYMBOL=ROUTEPAY
# Dev wallets must hold this much of the project token to activate a policy
MIN_HOLD_TO_ACTIVATE=1000000
# Optional: a lottery on another token than the project token
LOTTERY_TOKEN_ADDRESS=

# Security: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts dev wallets and page vaults. Losing it loses every vault: back it up.
MASTER_ENCRYPTION_KEY=your_64_character_hex_string_here

# Missions treasury: private key of the wallet that pays mission rewards (ETH)
TREASURY_PRIVATE_KEY=

# Pages: a vault paid only in stocks has no ETH to pay for its own sweep when
# its owner claims. This wallet lends it the gas (a few cents per claim).
# Without it such a vault waits until an ETH payment lands in it.
PAGES_GAS_PRIVATE_KEY=
# The most one sweep may borrow
PAGES_GAS_TOPUP_MAX_ETH=0.002

# Swap guard: a stock swap only executes if the pool delivers at least this fraction of the Yahoo fair price
MIN_SWAP_FAIR_RATIO=0.9
# Below this much spendable ETH a cycle is skipped
MIN_DISTRIBUTE_ETH=0.0005

# Optional RoutepayDisperse contract (contracts/RoutepayDisperse.sol): one tx pays up to 150 holders
DISPERSE_ADDRESS=

# Holder indexing
INDEX_CHUNK_BLOCKS=50000
INDEX_MAX_BLOCKS=4000000
# Extra addresses that never receive dividends (lockers, team wallets), comma separated
EXCLUDED_ADDRESSES=

# Shared secret for the web dashboard (frontend calls /api/internal/*)
INTERNAL_API_KEY=
